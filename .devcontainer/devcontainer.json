{
  "name": "whatadealuk",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:1-20-bookworm",
  "forwardPorts": [3000],
  "portsAttributes": {
    "3000": {
      "label": "Whatadeal app",
      "onAutoForward": "notify"
    }
  },
  "postCreateCommand": "npm install && cp -n env.example .env || true",
  "customizations": {
    "vscode": {
      "settings": {
        "files.exclude": {
          "**/.DS_Store": true
        }
      },
      "extensions": [
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode"
      ]
    }
  }
}
